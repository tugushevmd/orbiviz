================================================================================
                                       INPUT FILE
================================================================================
NAME = 10_sp_props.inp
|  1> # Property run at the optimized geometry.
|  2> # Expected outputs:
|  3> # - ORCA .out with Mulliken / Loewdin / Mayer / CHELPG analysis
|  4> # - XYZ coordinate file
|  5> # - electron-density cube
|  6> # - HOMO / LUMO cubes
|  7> # - molden file via: orca_2mkl 10_sp_props -molden
|  8> #
|  9> # Note:
| 10> # For C10H9NO2, charge 0 / multiplicity 1 gives 92 electrons -> 46 occupied MOs.
| 11> # Therefore HOMO=46 and LUMO=47 in the closed-shell reference.
| 12> ! B3LYP D3BJ def2-SVP def2/J RIJCOSX TightSCF
| 13> ! Mulliken Loewdin Mayer CHELPG XYZFile KEEPDENS
| 14> 
| 15> %maxcore 2000
| 16> 
| 17> %pal
| 18>   nprocs 8
| 19> end
| 20> 
| 21> %plots
| 22>   dim1 80
| 23>   dim2 80
| 24>   dim3 80
| 25>   Format Gaussian_Cube
| 26>   ElDens("c10h9no2_density.cube");
| 27>   MO("c10h9no2_homo.cube",46,0);
| 28>   MO("c10h9no2_lumo.cube",47,0);
| 29> end
| 30> 
| 31> * xyzfile 0 1 c10h9no2_opt.xyz
| 32> 
| 33>                          ****END OF INPUT****
